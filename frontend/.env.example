CONVEX_URL=
VITE_CONVEX_URL=

# Optional free/low-cost provider fallbacks.
# Leave blank and the app still works with TCGdex as primary.
POKEMON_TCG_API_KEY=
ENABLE_FREE_PROVIDER_FALLBACKS=true

# Optional eBay active-listing comps.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production

# Optional beta/experimental providers.
CARDDEX_API_KEY=
ENABLE_OPENTCG_FALLBACK=false

# Optional AI scan fallback. Local OCR still runs without this.
GEMINI_API_KEY=
